            {"name": "实现问答链", "priority": "high"},
            {"name": "测试和优化", "priority": "medium"}
          ]
        },
        {
          "name": "Agent 项目",
          "done_criteria": "Agent 能自主调用工具完成端到端任务",
          "deliverable": "可运行的 Agent 应用",
          "tasks": [
            {"name": "设计 Agent 架构", "priority": "high"},
            {"name": "实现 Tools", "priority": "high"},
            {"name": "实现 Memory", "priority": "medium"},
            {"name": "实现 Agent 循环", "priority": "high"},
            {"name": "测试和优化", "priority": "medium"}
