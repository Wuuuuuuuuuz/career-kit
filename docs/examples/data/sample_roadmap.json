            {"name": "学习装饰器", "priority": "medium"},
            {"name": "学习生成器", "priority": "medium"},
            {"name": "学习异步编程", "priority": "high"}
          ]
        },
        {
          "name": "LLM 基础",
          "done_criteria": "能解释 Transformer 与 Prompt Engineering 的核心概念并调通 API",
          "tasks": [
            {"name": "了解 Transformer 架构", "priority": "high"},
            {"name": "学习 Prompt Engineering", "priority": "high"},
            {"name": "学习 API 调用", "priority": "high"},
            {"name": "实践：调用 LLM API 完成一个小任务", "priority": "high"}
          ]
        },
        {
          "name": "LangChain 入门",
          "done_criteria": "不看文档写出一个带 Memory 和 Tools 的 Agent",
          "tasks": [
            {"name": "安装和配置", "priority": "medium"},
            {"name": "学习 Chain", "priority": "high"},
